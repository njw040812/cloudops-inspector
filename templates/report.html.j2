<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<title>CloudOps Inspector — {{ run.run_id[:8] }}</title>
<style>
  :root { --bg:#f5f7fa; --card:#fff; --ink:#1f2937; --muted:#6b7280; --line:#e5e7eb; --blue:#1d4ed8; --ok:#15803d; --warn:#b45309; --crit:#b91c1c; --error:#7c3aed; --skip:#6b7280; }
  * { box-sizing: border-box; }
  body { margin:0; background:var(--bg); color:var(--ink); font-family: "Segoe UI", "Microsoft YaHei", Arial, sans-serif; font-size:14px; }
  .wrap { max-width:1180px; margin:0 auto; padding:32px 24px 60px; }
  header { background:linear-gradient(120deg,#0f172a,#1d4ed8); color:#fff; padding:28px 32px; border-radius:14px; }
  header h1 { margin:0 0 8px; font-size:26px; }
  header .meta { opacity:.85; font-size:13px; line-height:1.8; }
  .cards { display:grid; grid-template-columns:repeat(5,1fr); gap:14px; margin:18px 0 26px; }
  .card { background:var(--card); border:1px solid var(--line); border-radius:12px; padding:16px; }
  .card .label { color:var(--muted); font-size:12px; }
  .card .value { font-size:26px; font-weight:700; margin-top:6px; }
  .score { font-size:30px; }
  h2 { font-size:18px; margin:28px 0 10px; }
  .host { background:var(--card); border:1px solid var(--line); border-radius:12px; padding:18px 18px 10px; margin-bottom:18px; }
  .host-head { display:flex; justify-content:space-between; align-items:baseline; gap:12px; border-bottom:1px solid var(--line); padding-bottom:10px; }
  .host-head .addr { color:var(--muted); font-size:12px; }
  .host-score { font-size:22px; font-weight:700; }
  table { width:100%; border-collapse:collapse; margin-top:10px; }
  th,td { text-align:left; padding:8px 10px; border-bottom:1px solid var(--line); vertical-align:top; }
  th { color:var(--muted); font-size:12px; font-weight:600; background:#fafafa; }
  td.num { white-space:nowrap; }
  .badge { display:inline-block; padding:2px 8px; border-radius:999px; font-size:12px; font-weight:600; color:#fff; }
  .b-ok { background:var(--ok); } .b-warn { background:var(--warn); } .b-crit { background:var(--crit); }
  .b-error { background:var(--error); } .b-skip { background:var(--skip); }
  .details { margin:10px 0 14px; padding:10px 14px; background:#fafafa; border-left:3px solid var(--line); border-radius:6px; }
  .details ul { margin:6px 0 0; padding-left:18px; }
  .muted { color:var(--muted); }
  @media (max-width:900px) { .cards { grid-template-columns:repeat(2,1fr); } }
  @media print { body { background:#fff; } header { background:#1d4ed8 !important; -webkit-print-color-adjust:exact; } .card,.host { break-inside:avoid; } }
</style>
</head>
<body>
<div class="wrap">
  <header>
    <h1>CloudOps Inspector 巡检报告</h1>
    <div class="meta">
      Run ID: {{ run.run_id }}<br>
      开始: {{ run.started_at.strftime("%Y-%m-%d %H:%M:%S") }} UTC ·
      耗时: {{ "%.0f"|format(run.duration_ms) }} ms ·
      主机: {{ run.hosts|length }}
    </div>
  </header>

  <div class="cards">
    <div class="card"><div class="label">总分</div><div class="value score">{{ run.score }}</div></div>
    <div class="card"><div class="label">正常</div><div class="value" style="color:var(--ok)">{{ run.counts.ok }}</div></div>
    <div class="card"><div class="label">警告</div><div class="value" style="color:var(--warn)">{{ run.counts.warn }}</div></div>
    <div class="card"><div class="label">严重</div><div class="value" style="color:var(--crit)">{{ run.counts.crit }}</div></div>
    <div class="card"><div class="label">失败 / 跳过</div><div class="value" style="color:var(--muted)">{{ run.counts.error }} / {{ run.counts.skip }}</div></div>
  </div>

  {% for host in run.hosts %}
  <div class="host">
    <div class="host-head">
      <div><strong>{{ host.host }}</strong> <span class="addr">{{ host.address }}</span></div>
      <div class="host-score">{{ host.score }}<span class="muted" style="font-size:12px">/100</span></div>
    </div>
    <table>
      <thead><tr><th style="width:26%">检查项</th><th style="width:10%">状态</th><th style="width:12%">数值</th><th>摘要</th></tr></thead>
      <tbody>
      {% for r in host.results %}
        <tr>
          <td>{{ r.name }}<div class="muted" style="font-size:11px">{{ r.category }}</div></td>
          <td><span class="badge b-{{ r.status.value }}">{{ labels.get(r.status.value, r.status.value) }}</span></td>
          <td class="num">{{ "" if r.value is none else "%.2f%s"|format(r.value, r.unit) }}</td>
          <td>{{ r.summary }}
            {% if r.details %}<div class="muted" style="font-size:11px;margin-top:3px">{{ r.details[:3]|join(" · ") }}</div>{% endif %}
          </td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
    {% set issues = host.results|selectattr("status.value","in",["warn","crit","error"])|list %}
    {% if issues %}
    <div class="details">
      <strong>需要关注</strong>
      <ul>
      {% for r in issues %}
        <li><strong>{{ r.name }}</strong>: {{ r.summary }}{% if r.remediation %}<br><span class="muted">建议：{{ r.remediation }}</span>{% endif %}</li>
      {% endfor %}
      </ul>
    </div>
    {% endif %}
  </div>
  {% endfor %}
  <p class="muted">只读巡检，不会修改主机配置。报告由 CloudOps Inspector 生成。</p>
</div>
</body>
</html>
