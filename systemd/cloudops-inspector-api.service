[Unit]
Description=CloudOps Inspector history and metrics API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/cloudops-inspector
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/cloudops-inspector/.venv/bin/python -m cloudops_inspector serve \
  --db /var/lib/cloudops/inspector.db \
  --host 127.0.0.1 \
  --port 8000
User=root
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
